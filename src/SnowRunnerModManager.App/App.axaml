<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SnowRunnerModManager.App.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
             
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="FontColor" Color="#eaeaea" />
            <SolidColorBrush x:Key="NavigationColor" Color="#0a0a0a"/>        
            <SolidColorBrush x:Key="SeparatorColor" Color="#040404"/>                
    
            <SolidColorBrush x:Key="TextSuccess" Color="#87f383"/>
            <SolidColorBrush x:Key="TextInfo" Color="#6ec0ff"/>
            <SolidColorBrush x:Key="TextWarning" Color="#ffdf9a"/>
            <SolidColorBrush x:Key="TextError" Color="#f36a77"/>
            <SolidColorBrush x:Key="TextCritical" Color="#ff0000"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="./Resources/WindowDeco.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>