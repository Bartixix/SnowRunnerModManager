<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:SnowRunnerModManager.App.EditorUserControls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SnowRunnerModManager.App.EditorUserControls.EditorSimpleClassControl"
             x:DataType="local:EditorSimpleClassControl">
    <StackPanel Spacing="5">
        <TextBlock x:Name="InputHeader"/>
        
        <StackPanel x:Name="MainPanel" Grid.Column="1">
                
        </StackPanel>
        
    </StackPanel>
</UserControl>
