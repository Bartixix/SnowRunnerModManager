<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:SnowRunnerModManager.App.UserContorls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="450"
             x:Class="SnowRunnerModManager.App.UserContorls.SideBar">
    <Grid RowDefinitions="*, 3, auto" Background="{StaticResource NavigationColor}">
        <StackPanel Grid.Row="0">
            
        </StackPanel>

        <Border Grid.Row="1" Height="3" Background="{StaticResource SeparatorColor}"/>
        <local:InfoPanel Grid.Row="2" Background="{StaticResource NavigationColor}"/>
    </Grid>
</UserControl>
